# Keep upstream toolchain license notices in Git, not the 261 MB binary tree.
toolchain/*
!toolchain/README.txt
!toolchain/THIRD-PARTY.txt
!toolchain/CLANGD-THIRD-PARTY.txt

# Local IDE caches, secrets and user-specific configuration
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx

# macOS release artifacts
dist-macos/
# macOS release output
*.app/
